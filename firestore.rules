rules_version = '2';

// Reglas de seguridad de Recreo.
// Se copian en Firebase → Firestore Database → Reglas → Publicar.
//
// Resumen:
// - Docentes (cuenta de Google): ven y editan solo sus bancos y sus salas.
// - Alumnos y pantalla grande (sesión anónima): leen la sala; cada alumno escribe
//   solo su nombre y sus respuestas; ve solo su propia palabra secreta.
// - Las respuestas correctas del juego viven en «privado» y solo las ve el docente.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function esDocente() {
      return conSesion() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /bancos/{id} {
      allow read, delete: if esDocente() && resource.data.owner == request.auth.uid;
      allow create: if esDocente() && request.resource.data.owner == request.auth.uid;
      allow update: if esDocente() && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
    }

    match /salas/{codigo} {
      function sala() {
        return get(/databases/$(database)/documents/salas/$(codigo)).data;
      }
      function esDuenio() {
        return conSesion() && sala().owner == request.auth.uid;
      }
      function vigente() {
        return sala().expira > request.time;
      }

      allow get: if conSesion();
      allow list: if esDocente() && resource.data.owner == request.auth.uid;
      allow create: if esDocente() && codigo.matches('^[A-Z]{4}$')
                    && request.resource.data.owner == request.auth.uid;
      allow update: if conSesion() && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == resource.data.owner;
      allow delete: if conSesion() && resource.data.owner == request.auth.uid;

      match /jugadores/{uid} {
        allow read: if conSesion();
        allow create, update: if conSesion() && request.auth.uid == uid && vigente()
                              && request.resource.data.keys().hasOnly(['nombre', 'unido'])
                              && request.resource.data.nombre is string
                              && request.resource.data.nombre.size() > 0
                              && request.resource.data.nombre.size() <= 20;
        allow delete: if conSesion() && (request.auth.uid == uid || esDuenio());
      }

      match /respuestas/{uid} {
        allow read: if conSesion();
        allow create, update: if conSesion() && request.auth.uid == uid && vigente()
                              && exists(/databases/$(database)/documents/salas/$(codigo)/jugadores/$(uid))
                              && request.resource.data.keys().hasOnly(['juego', 'equipo', 't', 'ronda', 'valor', 'paso', 'accion', 'voto', 'palabras'])
                              && (!('valor' in request.resource.data) || request.resource.data.valor is int
                                  || (request.resource.data.valor is string && request.resource.data.valor.size() <= 80))
                              && (!('palabras' in request.resource.data)
                                  || (request.resource.data.palabras is list && request.resource.data.palabras.size() <= 3));
        allow delete: if esDuenio();
      }

      match /secretos/{uid} {
        allow read: if conSesion() && (request.auth.uid == uid || esDuenio());
        allow write: if esDuenio();
      }

      match /privado/{doc} {
        allow read, write: if esDuenio();
      }
    }
  }
}
